+void CLaserOdometry2DNode::publishQuality(bool solved)
+{
+  diagnostic_msgs::msg::DiagnosticArray message;
+  message.header = last_scan.header;
+  diagnostic_msgs::msg::DiagnosticStatus status;
+  status.name = "rf2o_solver";
+  const bool valid = solved && rf2o_ref.quality_valid;
+  status.level = valid ? 0 : 2;
+  status.message = valid ? "finest-level solver metrics" : "solver metrics unavailable or invalid";
+  const auto add = [&status](const std::string &key, const std::string &value) {
+    diagnostic_msgs::msg::KeyValue pair;
+    pair.key = key;
+    pair.value = value;
+    status.values.push_back(pair);
+  };
+  add("valid", valid ? "1" : "0");
+  add("valid_points", std::to_string(rf2o_ref.quality_points));
+  add("rotation_scale", "2.0");
+  if (valid)
+  {
+    add("weighted_residual_rms", std::to_string(rf2o_ref.quality_residual));
+    for (int i=0; i<3; ++i)
+    {
+      add("information_eigenvalue_" + std::to_string(i), std::to_string(rf2o_ref.quality_eigenvalues(i)));
+      for (int j=0; j<3; ++j)
+        add("information_eigenvector_" + std::to_string(i) + "_" + std::to_string(j),
+            std::to_string(rf2o_ref.quality_eigenvectors(j,i)));
+    }
+  }
+  message.status.push_back(status);
+  quality_pub->publish(message);
+}
